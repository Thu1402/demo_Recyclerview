<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:context=".Article"
    android:orientation="horizontal"
    android:padding="20dp">
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">
    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tiêu đề bài viết"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:textAppearance="@style/TextAppearance.AppCompat.Title"
        />

    <TextView
        android:id="@+id/txtContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nội dùng bài viết"
        android:paddingTop="10dp"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"/>

    <TextView
        android:id="@+id/txtViews"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Lượt xem"
        android:paddingTop="7dp"
        android:textAppearance="@style/MaterialAlertDialog.MaterialComponents.Title.Text"/>

    </LinearLayout>

    <!--ben phai-->

    <ImageView
        android:id="@+id/imgCover"
        android:layout_width="100dp"
        android:layout_height="80dp"
        android:layout_marginStart="20dp"
        android:scaleType="centerCrop"
        android:src="@drawable/img_news1"
        />
</LinearLayout>